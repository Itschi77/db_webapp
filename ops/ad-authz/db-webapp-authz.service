[Unit]
Description=DB Webapp AD group authorization helper
After=network-online.target sssd.service
Wants=network-online.target
Requires=sssd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/db-webapp-authz/db-webapp-authz.py
User=nobody
Group=nogroup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
